# Frontend: dirección de la API FastAPI.
VITE_API_URL=http://127.0.0.1:8000/api

# La variable MANAGER_STOCK_DB es leída directamente por el backend desde el entorno
# del proceso. No se carga desde este archivo automáticamente. Valor predeterminado:
# backend/data/manager_stock.db

# ---------------------------------------------------------------------------
# Firebase (F2F.1). La configuración web es pública; la seguridad la dan
# firestore.rules y los custom claims. No poner secretos con prefijo VITE_.
#
# Mientras se usan los emuladores, el proyecto debe empezar por "demo-".
# La app todavía no inicializa Firebase: estas variables se consumen a partir
# de F2F.3 (repositorio remoto y bandera VITE_RESTAURANT_BACKEND).
# ---------------------------------------------------------------------------
VITE_RESTAURANT_BACKEND=local
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-manager-stock.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-manager-stock
VITE_FIREBASE_STORAGE_BUCKET=demo-manager-stock.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_FIREBASE_EMULATORS=true
