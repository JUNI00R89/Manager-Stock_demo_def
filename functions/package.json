{
  "name": "manager-stock-functions",
  "private": true,
  "version": "1.0.0",
  "description": "Cloud Functions para el flujo de pedidos de restaurante (Firebase).",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.7.3"
  }
}
