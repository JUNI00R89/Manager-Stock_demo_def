{
  "name": "manager-stock",
  "private": true,
  "version": "2.0.0",
  "description": "Manager Stock - inventario, ventas y operación para negocios",
  "author": "Manager Stock",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "backend": "python -m uvicorn backend.main:app --reload --host 127.0.0.1 --port 8000",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron .",
    "desktop:build": "npm run build && electron-builder --win nsis",
    "firebase:emulators": "firebase emulators:start --project demo-manager-stock",
    "firebase:seed": "node scripts/seed_firebase_emulator.mjs",
    "firebase:test-rules": "firebase emulators:exec --project demo-manager-stock --only firestore \"node scripts/test_firestore_rules.mjs\"",
    "firebase:test-functions": "firebase emulators:exec --project demo-manager-stock --only auth,firestore,functions \"node scripts/seed_firebase_emulator.mjs && node scripts/test_functions_emulator.mjs\""
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "^13.2.0",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "22.13.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "jsdom": "^31.0.0",
    "tailwindcss": "4.1.12",
    "typescript": "5.7.3",
    "vite": "6.3.5",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  },
  "build": {
    "appId": "com.managerstock.app",
    "productName": "Manager Stock",
    "copyright": "Copyright © 2026 Manager Stock",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json",
      "!node_modules/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Manager-Stock-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Manager Stock",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "1034"
    }
  }
}
